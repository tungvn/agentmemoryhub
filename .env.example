# ── Required ───────────────────────────────────────────────────────────────────

# Named tunnel token from https://one.dash.cloudflare.com/ → Zero Trust → Tunnels
# If unset, the container runs as localhost-only (no public tunnel).
CLOUDFLARE_TOKEN=

# Bearer token for all REST API and MCP requests.
# Generate with: openssl rand -hex 32
AGENTMEMORY_SECRET=

# ── Optional: LLM features ─────────────────────────────────────────────────────
# Enables consolidation pipeline, knowledge graph extraction, auto-compress,
# and reflection synthesis. Any one key activates the features.

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
# For OpenAI-compatible providers (Ollama, vLLM, LM Studio, DeepSeek):
# OPENAI_BASE_URL=http://host.docker.internal:11434/v1

# ── Optional: agentmemory feature flags ────────────────────────────────────────

# Expose all 51 MCP tools (default: core — 7 tools)
# AGENTMEMORY_TOOLS=all

# LLM-powered 4-tier consolidation pipeline (requires OPENAI_API_KEY)
# CONSOLIDATION_ENABLED=true

# Knowledge graph edge extraction (requires OPENAI_API_KEY)
# GRAPH_EXTRACTION_ENABLED=true

# LLM compression on every observation batch (requires OPENAI_API_KEY)
# AGENTMEMORY_AUTO_COMPRESS=true

# Periodic reflection synthesis (requires OPENAI_API_KEY)
# AGENTMEMORY_REFLECT=true

# Periodic state snapshots to /data/snapshots
# SNAPSHOT_ENABLED=true

# Team memory scoping (multi-agent / shared memory)
# TEAM_MODE=shared
# TEAM_ID=my-team
# USER_ID=my-user

# Sync compressed memories into CLAUDE.md (requires CLAUDE_PROJECT_PATH)
# CLAUDE_MEMORY_BRIDGE=true
# CLAUDE_PROJECT_PATH=/path/to/your/project

# ── Ports (only change if you have port conflicts) ─────────────────────────────
# III_REST_PORT=3111
